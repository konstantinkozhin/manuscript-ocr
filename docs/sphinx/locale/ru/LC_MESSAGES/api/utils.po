#: 195651bf5faa46a19cfee10bcc184edf manuscript.utils.io.read_image:12 of
msgid "RGB image as numpy array with shape (H, W, 3) and dtype uint8."
msgstr "RGB-изображение в виде массива NumPy с формой (H, W, 3) и типом uint8."

#: 134e368ce8704089ae3f9a682adddeab 142da3b39001469ca176c76cc9857035
#: 14710007f1564ef393ce7dfc31ec83e1 74bdde1346d1444f8c3eb8cc285902a6

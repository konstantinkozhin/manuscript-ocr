#: 2a2aaa14ec5b419da5298f74196ee515 manuscript.correctors._charlm.CharLM:12 of
msgid "HTTP/HTTPS URL: ``\"https://example.com/model.onnx\"``"
msgstr "HTTP/HTTPS URL: ``\"https://example.com/model.onnx\"``"

#: 0699760b8bc94f6980ab770474278614 manuscript.correctors._charlm.CharLM:13 of
msgid "GitHub release: ``\"github://owner/repo/tag/file.onnx\"``"
msgstr "GitHub release: ``\"github://owner/repo/tag/file.onnx\"``"

#: 014e9cd894ba4e2aada664c28f8d74b3 manuscript.correctors._charlm.CharLM:14 of
msgid "Google Drive: ``\"gdrive:FILE_ID\"``"
msgstr "Google Drive: ``\"gdrive:FILE_ID\"``"

#: aa5fa0889c084ba68185fc88696266e3 manuscript.correctors._charlm.CharLM:15 of
msgid ""
"Preset name: ``\"prereform_charlm_g1\"`` or ``\"modern_charlm_g1\"`` (from "
"pretrained_registry)"
msgstr ""
"Имя пресета: ``\"prereform_charlm_g1\"`` или ``\"modern_charlm_g1\"`` (из "
"pretrained_registry)"


msgid "Character-level text corrector for post-processing OCR results."
msgstr "Символьный корректор текста для постобработки результатов OCR."

#: api/correctors.rst:7 bb2efd3fb655409d94a19a2640b3e970
msgid "``CharLM``"
msgstr "``CharLM``"

#: eb3b438ddc3541f7b4f333d6929401c5 manuscript.correctors._charlm.CharLM:1 of

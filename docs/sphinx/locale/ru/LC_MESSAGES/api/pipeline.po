#: 07aef321790346b9bb9f8c983a5ec438 api/pipeline.rst:4
msgid "The main high-level interface for OCR processing."
msgstr "Основной высокоуровневый интерфейс для OCR-обработки."

#: 89f5236751894647860bbc88f29b0c9a manuscript._pipeline.Pipeline:1 of
